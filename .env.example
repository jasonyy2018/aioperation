# 自媒体AI运营平台 环境变量配置
# 使用方法: 复制本文件为 .env.local 并填入您的真实密钥

# ===== AI 服务商 API Key =====
# MiniMax (海螺AI) - 文本/生图/视频
MM_API_KEY=your_minimax_api_key_here
# 腾讯混元 - 生图/视频
HY_API_KEY=your_hunyuan_api_key_here
# Agnes AI - 生图/视频
AGNES_API_KEY=your_agnes_api_key_here
# 字节火山方舟 - 文本模型 (需有效 CodingPlan 订阅)
ARK_API_KEY=your_ark_api_key_here
# Seedance 2 Mini (AggregateAPI) - 视频
SEEDANCE_MINI_API_KEY=your_seedance_api_key_here

# ===== 服务配置 =====
# 服务监听端口
PORT=8765

# SQLite 数据库存储目录 (默认: <项目根目录>/data)
# Docker 部署时建议挂载持久化卷: -v ./data:/app/data
# AUTOMEDIA_DATA_DIR=/var/lib/automedia
